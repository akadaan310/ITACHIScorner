{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itachis-corner.invalid/private-research/learning-unit-draft.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "template_only": {
      "const": true
    },
    "draft_kind": {
      "const": "learning_unit"
    },
    "unit_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "enum": [
        "blocked_on_corpus",
        "private_draft",
        "review_requested",
        "changes_requested"
      ]
    },
    "instructional_claim": {
      "type": [
        "string",
        "null"
      ]
    },
    "learning_objective": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_pack_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "video_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "track_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "transcript_version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "segment_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "end_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "extraction_version": {
            "type": "string",
            "minLength": 1
          },
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "review_decision_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "video_id",
          "track_id",
          "transcript_version",
          "segment_id",
          "start_ms",
          "end_ms",
          "source_sha256",
          "extraction_version",
          "finding_id",
          "review_decision_id"
        ],
        "additionalProperties": false
      }
    },
    "counterexample_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "video_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "track_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "transcript_version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "segment_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "end_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "extraction_version": {
            "type": "string",
            "minLength": 1
          },
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "review_decision_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "video_id",
          "track_id",
          "transcript_version",
          "segment_id",
          "start_ms",
          "end_ms",
          "source_sha256",
          "extraction_version",
          "finding_id",
          "review_decision_id"
        ],
        "additionalProperties": false
      }
    },
    "uncertainty_statement": {
      "type": [
        "string",
        "null"
      ]
    },
    "exercise": {
      "type": [
        "string",
        "null"
      ]
    },
    "assessment_rubric": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prerequisite_finding_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "content_review": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "not_requested",
            "pending",
            "changes_requested",
            "rejected",
            "approved"
          ]
        },
        "reviewer_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "decision_reference": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "state",
        "reviewer_id",
        "decision_at",
        "decision_reference"
      ],
      "additionalProperties": false
    },
    "creator_authorization": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "not_requested",
            "pending",
            "changes_requested",
            "rejected",
            "approved"
          ]
        },
        "reviewer_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "decision_reference": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "state",
        "reviewer_id",
        "decision_at",
        "decision_reference"
      ],
      "additionalProperties": false
    },
    "scholarly_review": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "not_requested",
            "pending",
            "changes_requested",
            "rejected",
            "approved"
          ]
        },
        "reviewer_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "decision_reference": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "state",
        "reviewer_id",
        "decision_at",
        "decision_reference"
      ],
      "additionalProperties": false
    },
    "attributed_to_creator": {
      "const": false
    },
    "pedagogy_eligible": {
      "const": false
    },
    "publication_allowed": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "template_only",
    "draft_kind",
    "unit_id",
    "state",
    "instructional_claim",
    "learning_objective",
    "evidence_pack_refs",
    "counterexample_refs",
    "uncertainty_statement",
    "exercise",
    "assessment_rubric",
    "prerequisite_finding_ids",
    "content_review",
    "creator_authorization",
    "scholarly_review",
    "attributed_to_creator",
    "pedagogy_eligible",
    "publication_allowed"
  ],
  "additionalProperties": false,
  "description": "Metadata-only private draft contract. No generated curriculum is present. Authentication-bound promotion belongs to the separately gated editorial service, never this template."
}
