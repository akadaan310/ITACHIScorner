{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itachis-corner.invalid/private-research/book-plan-draft.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "template_only": {
      "const": true
    },
    "draft_kind": {
      "const": "book_plan"
    },
    "state": {
      "const": "blocked_on_corpus"
    },
    "requested_page_target": {
      "type": "object",
      "properties": {
        "minimum": {
          "const": 300
        },
        "maximum": {
          "const": 400
        },
        "scope_requires_validated_evidence": {
          "const": true
        }
      },
      "required": [
        "minimum",
        "maximum",
        "scope_requires_validated_evidence"
      ],
      "additionalProperties": false
    },
    "approved_title": {
      "type": "null"
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chapter_id": {
            "type": "string",
            "minLength": 1
          },
          "working_title": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_pack_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "video_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,128}$"
                },
                "track_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,128}$"
                },
                "transcript_version": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,128}$"
                },
                "segment_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,128}$"
                },
                "start_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "end_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "extraction_version": {
                  "type": "string",
                  "minLength": 1
                },
                "finding_id": {
                  "type": "string",
                  "minLength": 1
                },
                "review_decision_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "video_id",
                "track_id",
                "transcript_version",
                "segment_id",
                "start_ms",
                "end_ms",
                "source_sha256",
                "extraction_version",
                "finding_id",
                "review_decision_id"
              ],
              "additionalProperties": false
            }
          },
          "review_state": {
            "enum": [
              "blocked_on_corpus",
              "private_draft",
              "pending_review"
            ]
          },
          "manuscript_reference": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "chapter_id",
          "working_title",
          "evidence_pack_refs",
          "review_state",
          "manuscript_reference"
        ],
        "additionalProperties": false
      }
    },
    "manuscript_reference": {
      "type": "null"
    },
    "source_snapshot": {
      "type": "null"
    },
    "creator_authorization": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "not_requested",
            "pending",
            "changes_requested",
            "rejected",
            "approved"
          ]
        },
        "reviewer_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "decision_reference": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "state",
        "reviewer_id",
        "decision_at",
        "decision_reference"
      ],
      "additionalProperties": false
    },
    "content_review": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "not_requested",
            "pending",
            "changes_requested",
            "rejected",
            "approved"
          ]
        },
        "reviewer_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "decision_reference": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "state",
        "reviewer_id",
        "decision_at",
        "decision_reference"
      ],
      "additionalProperties": false
    },
    "publication_allowed": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "template_only",
    "draft_kind",
    "state",
    "requested_page_target",
    "approved_title",
    "chapters",
    "manuscript_reference",
    "source_snapshot",
    "creator_authorization",
    "content_review",
    "publication_allowed"
  ],
  "additionalProperties": false,
  "description": "Empty editorial metadata scaffold only. Page target is the request, not a manuscript length commitment."
}
