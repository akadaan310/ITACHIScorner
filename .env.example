# No credentials are enabled by default. Use the creator's separately authorized project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret or legacy service-role key; required only for account hard deletion.
# Never prefix this variable with NEXT_PUBLIC_ or include it in browser bundles.
SUPABASE_SECRET_KEY=

# Independent concept imagery. Set false to withhold all unapproved portraits.
NEXT_PUBLIC_CREATOR_PORTRAITS=true
